manifest {
    name            = 'scrna-nf-seurat'
    description     = 'Single-cell RNA-seq QC and integration with Nextflow and R (Seurat, scDblFinder, Harmony)'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.10.0'
    version         = '0.1.0'
}

params {
    // Input / output
    input         = null          // samplesheet CSV: sample,condition,donor,matrix_dir
    outdir        = 'results'

    // QC
    min_features  = 200           // minimum genes detected per cell
    max_mito      = 10            // maximum % mitochondrial reads
    mito_pattern  = '^MT-'        // use '^mt-' for mouse

    // Integration
    batch_var     = null          // technical batch for Harmony (e.g. 'run'); null = no correction.
                                  // Never a variable nested in condition (the script checks this).
    n_pcs         = 30
    resolution    = 0.5

    // AWS Batch (only used with -profile awsbatch)
    aws_queue     = null
    aws_region    = 'us-east-1'
}

process {
    // Replace OWNER with your GitHub user after building/pushing the image (see Dockerfile)
    container     = 'ghcr.io/OWNER/scrna-nf-seurat:0.1.0'

    // Retry on out-of-memory / Spot interruption style exit codes, otherwise let running tasks finish
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_medium {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 6.h * task.attempt }
    }

    withName: SC_QC {
        publishDir = [path: { "${params.outdir}/qc" }, mode: 'copy']
    }

    withName: SC_INTEGRATE {
        publishDir = [path: { "${params.outdir}/integrated" }, mode: 'copy']
    }
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    slurm {
        process.executor = 'slurm'
    }

    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = params.aws_queue
        aws.region       = params.aws_region
        // Set -work-dir to an S3 path, e.g. -work-dir s3://my-bucket/work
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
